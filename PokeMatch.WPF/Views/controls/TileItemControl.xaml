<UserControl x:Class="PokeMatch.WPF.Views.controls.TileItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="100">
    <Border x:Name="TileBorder" 
            BorderThickness="2" 
            BorderBrush="Transparent"
            Background="LightGray"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="TileTranslate" X="0" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Image x:Name="TileImage" 
               Source="{Binding AssetSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    </Border>
</UserControl>
