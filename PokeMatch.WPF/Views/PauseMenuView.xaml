<UserControl x:Class="PokeMatch.WPF.Views.PauseMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="800"
             MinHeight="450">

    <Grid Background="#B8000000">

        <Border Width="440"
                Padding="28"
                Background="#1B2942"
                BorderBrush="#496B99"
                BorderThickness="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="PAUSED"
                           Style="{StaticResource EnglishPixelText}"
                           Foreground="#F6C85F"
                           FontSize="25"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Button Content="RESUME"
                        Style="{StaticResource PixelMenuButton}"
                        Command="{Binding ResumeCommand}"/>

                <Button Content="RESTART"
                        Style="{StaticResource PixelMenuButton}"
                        Command="{Binding RestartCommand}"/>

                <Button Content="SETTINGS"
                        Style="{StaticResource PixelMenuButton}"
                        Command="{Binding SettingsCommand}"/>

                <Button Content="MAIN MENU"
                        Style="{StaticResource PixelMenuButton}"
                        Command="{Binding MainMenuCommand}"/>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
