<UserControl x:Class="PokeMatch.WPF.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="800"
             MinHeight="450">

    <!-- ========================================== -->
    <!-- RESOURCES                                  -->
    <!-- ========================================== -->

    <UserControl.Resources>

        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility"/>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="MenuBackground"
                         Color="#10182B"/>

        <SolidColorBrush x:Key="MenuPanel"
                         Color="#1B2942"/>

        <SolidColorBrush x:Key="MenuAccent"
                         Color="#F6C85F"/>

        <SolidColorBrush x:Key="MenuText"
                         Color="#F4F0DE"/>

    </UserControl.Resources>


    <!-- ========================================== -->
    <!-- MAIN LAYOUT                                -->
    <!-- ========================================== -->

    <Grid Background="{StaticResource MenuBackground}">

        <!-- Background Decoration -->
        <Grid>

            <Ellipse Width="500"
                     Height="500"
                     Fill="#203B65"
                     Opacity="0.25"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-200,-250,0,0"/>

            <Ellipse Width="450"
                     Height="450"
                     Fill="#354C70"
                     Opacity="0.15"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-180,-200"/>

        </Grid>


        <!-- ====================================== -->
        <!-- MENU CONTENT                           -->
        <!-- ====================================== -->

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">


                <!-- GAME TITLE -->

                <TextBlock Text="POKEMATCH"
                           Style="{StaticResource EnglishPixelText}"
                           FontSize="35"
                           FontWeight="Bold"
                           Foreground="{StaticResource MenuAccent}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <!-- SUBTITLE -->

                <TextBlock Text="A PIXEL MATCHING ADVENTURE"
                           Style="{StaticResource EnglishPixelText}"
                           FontSize="13"
                           Foreground="#A9BDD8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,35"/>


                <!-- POKEMON SPRITES -->

                <Grid Margin="0,0,0,20">

                    <Image Source="/Assets/Sprites/25.png"
                           Width="65"
                           Height="65"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"/>

                    <Image Source="/Assets/Sprites/1.png"
                           Width="65"
                           Height="65"
                           HorizontalAlignment="Right"
                           Stretch="Uniform"/>

                </Grid>


                <!-- MENU BUTTONS -->

                <Button Content="NEW GAME"
                        Style="{StaticResource PixelMenuButton}"
                        Command="{Binding NewGameCommand}"/>

                <Button Content="CONTINUE"
                        Style="{StaticResource PixelMenuButton}"
                        Command="{Binding ContinueCommand}"/>

                <Button Content="SETTINGS"
                        Style="{StaticResource PixelMenuButton}"
                        Command="{Binding SettingsCommand}"/>

                <Button Content="QUIT"
                        Style="{StaticResource PixelMenuButton}"
                        Command="{Binding QuitCommand}"/>


                <!-- FOOTER -->

                <TextBlock Text="PRESS START TO PLAY"
                           Style="{StaticResource EnglishPixelText}"
                           FontSize="10"
                           Foreground="#8499B7"
                           HorizontalAlignment="Center"
                           Margin="0,25,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ====================================== -->
        <!-- SETTINGS POPUP                         -->
        <!-- ====================================== -->

        <Grid Background="#CC080F1D"
              Panel.ZIndex="10"
              Visibility="{Binding IsSettingsOpen,
                           Converter={StaticResource BoolToVisibility}}">


            <!-- SETTINGS PANEL -->

            <Border Width="430"
                    Padding="30"
                    Background="{StaticResource MenuPanel}"
                    BorderBrush="{StaticResource MenuAccent}"
                    BorderThickness="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">


                <StackPanel>


                    <!-- TITLE -->
                    <TextBlock Text="SETTINGS"
                               Style="{StaticResource EnglishPixelText}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource MenuAccent}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <!-- MUSIC VOLUME -->
                    <TextBlock Text="MUSIC VOLUME"
                               Style="{StaticResource EnglishPixelText}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource MenuText}"/>

                    <Slider Minimum="0"
                            Maximum="100"
                            Value="{Binding MusicVolume, Mode=TwoWay}"
                            Margin="0,10,0,25"/>

                    <!-- SOUND EFFECTS VOLUME -->
                    <TextBlock Text="SOUND EFFECTS VOLUME"
                               Style="{StaticResource EnglishPixelText}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource MenuText}"/>

                    <Slider Minimum="0"
                            Maximum="100"
                            Value="{Binding SoundEffectsVolume, Mode=TwoWay}"
                            Margin="0,10,0,25"/>

                    <!-- BRIGHTNESS -->
                    <TextBlock Text="BRIGHTNESS"
                               Style="{StaticResource EnglishPixelText}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource MenuText}"/>

                    <Slider Minimum="30"
                            Maximum="100"
                            Value="{Binding Brightness, Mode=TwoWay}"
                            Margin="0,10,0,30"/>


                    <!-- BACK BUTTON -->

                    <Button Content="BACK"
                            Style="{StaticResource PixelMenuButton}"
                            Width="200"
                            HorizontalAlignment="Center"
                            Command="{Binding CloseSettingsCommand}"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
