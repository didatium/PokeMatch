<UserControl x:Class="PokeMatch.WPF.Views.GamePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:PokeMatch.WPF.Views.controls"
             xmlns:converters="clr-namespace:PokeMatch.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             MinWidth="800" MinHeight="450">

    <UserControl.Resources>
        <converters:PercentageConverter x:Key="PercentageConverter"/>

        <SolidColorBrush x:Key="GameBackground" Color="#10182B"/>
        <SolidColorBrush x:Key="HudBackground" Color="#1B2942"/>
        <SolidColorBrush x:Key="HudBorder" Color="#304568"/>
        <SolidColorBrush x:Key="GameAccent" Color="#F6C85F"/>
        <SolidColorBrush x:Key="GameText" Color="#F4F0DE"/>

        <!-- Action Button kế thừa PixelMenuButton từ App.xaml -->
        <Style x:Key="GameActionButton"
               TargetType="Button"
               BasedOn="{StaticResource PixelMenuButton}">
            <Setter Property="Width" Value="135"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource GameBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="84"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ====================================== -->
        <!-- TOP HUD SECTION                        -->
        <!-- ====================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource HudBackground}"
                BorderBrush="{StaticResource HudBorder}"
                BorderThickness="0,0,0,3"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Difficulty & Score -->
                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DifficultyLbl"
                               Style="{StaticResource EnglishPixelText}"
                               Text="{Binding DifficultyText, FallbackValue='DIFFICULTY: EASY'}"
                               Foreground="#A9BDD8"
                               FontSize="11"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="ScoreLabel"
                               Style="{StaticResource EnglishPixelText}"
                               Text="{Binding Score, StringFormat='SCORE: {0}', FallbackValue='SCORE: 0'}"
                               Foreground="{StaticResource GameAccent}"
                               FontSize="14"/>
                </StackPanel>

                <!-- Center: Retro Timer & Lives -->
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TimerLabel"
                               Style="{StaticResource EnglishPixelText}"
                               Text="{Binding TimerText, FallbackValue='02:00'}"
                               Foreground="{StaticResource GameText}"
                               FontSize="24"
                               HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0">
                        <TextBlock x:Name="Heart1" Text="♥" FontSize="18" Foreground="#FF595E" Margin="3,0"/>
                        <TextBlock x:Name="Heart2" Text="♥" FontSize="18" Foreground="#FF595E" Margin="3,0"/>
                        <TextBlock x:Name="Heart3" Text="♥" FontSize="18" Foreground="#FF595E" Margin="3,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Back Button -->
                <Button Grid.Column="2"
                        Content="BACK"
                        Style="{StaticResource GameActionButton}"
                        Width="110"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding BackCommand}"/>
            </Grid>
        </Border>

        <!-- ====================================== -->
        <!-- GAME BOARD SECTION (Giới hạn 70%)      -->
        <!-- ====================================== -->
        <Grid x:Name="BoardContainer"
              Grid.Row="1"
              Margin="16">
            <Grid x:Name="BoardHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="{Binding ActualWidth, ElementName=BoardContainer, Converter={StaticResource PercentageConverter}, ConverterParameter=0.7}"
                  MaxHeight="{Binding ActualHeight, ElementName=BoardContainer, Converter={StaticResource PercentageConverter}, ConverterParameter=0.7}">

                <Border Background="#162238"
                        BorderBrush="{StaticResource HudBorder}"
                        BorderThickness="3"
                        Padding="8">
                    <ItemsControl x:Name="TileItemsControl"
                                  ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding BoardRows, FallbackValue=6}"
                                             Columns="{Binding BoardColumns, FallbackValue=8}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:TileItemControl
                                    IsSelected="{Binding IsSelected}"
                                    AssetSource="{Binding AssetSource}"
                                    TileId="{Binding TileId}"
                                    IsExploding="{Binding IsExploding}"
                                    Cursor="Hand"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Lớp Canvas phủ đè vẽ tia sét nối cặp & hạt nổ pixel -->
                <controls:ConnectorOverlayCanvas x:Name="ConnectorCanvas"
                                                 Panel.ZIndex="10"/>
            </Grid>
        </Grid>

        <!-- ====================================== -->
        <!-- BOTTOM QUICK ACTION BUTTONS            -->
        <!-- ====================================== -->
        <Border Grid.Row="2"
                Background="{StaticResource HudBackground}"
                BorderBrush="{StaticResource HudBorder}"
                BorderThickness="0,3,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="PauseBtn"
                        Content="PAUSE"
                        Style="{StaticResource GameActionButton}"
                        Command="{Binding PauseCommand}"/>
                <Button x:Name="RestartBtn"
                        Content="RESTART"
                        Style="{StaticResource GameActionButton}"
                        Command="{Binding RestartCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
