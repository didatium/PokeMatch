<UserControl x:Class="PokeMatch.WPF.Views.GamePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PokeMatch.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Section -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Difficulty Label -->
            <Label x:Name="DifficultyLbl" 
                   Grid.Column="0"
                   Content="Difficulty: Easy"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>

            <!-- Center: Timer Label -->
            <Label x:Name="TimerLabel" 
                   Grid.Column="1"
                   Content="00:00"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="24"/>

            <!-- Right: Pause Button -->
            <Button x:Name="PauseBtn" 
                    Grid.Column="2"
                    Content="Pause"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Width="80"
                    Height="35"/>
        </Grid>

        <!-- Game Board Section -->
        <Grid x:Name="GameBoardGrid" Grid.Row="1">
        </Grid>
    </Grid>
</UserControl>
